{
 "multipart": [
  {
   "apply": {
    "model": "realpower:block/dam_crest"
   }
  },
  {
   "when": {
    "rail": "north"
   },
   "apply": {
    "model": "realpower:block/dam_crest_rail"
   }
  },
  {
   "when": {
    "rail": "east"
   },
   "apply": {
    "model": "realpower:block/dam_crest_rail",
    "y": 90
   }
  },
  {
   "when": {
    "rail": "south"
   },
   "apply": {
    "model": "realpower:block/dam_crest_rail",
    "y": 180
   }
  },
  {
   "when": {
    "rail": "west"
   },
   "apply": {
    "model": "realpower:block/dam_crest_rail",
    "y": 270
   }
  }
 ]
}